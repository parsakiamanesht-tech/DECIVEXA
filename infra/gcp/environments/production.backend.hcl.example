# SAFE PLACEHOLDER FILE — copy to a local, untracked "production.backend.hcl"
# and replace every value below, only AFTER infra/gcp-bootstrap has
# actually been applied by an authorized operator (Increment 025 design
# only — that apply is not authorized or performed by this record). The
# real value comes from infra/gcp-bootstrap's own "production_state_bucket"
# output once it has actually run. Pass this file to
# `terraform init -backend-config=production.backend.hcl` for the
# production environment. Must never contain a real bucket name until the
# bucket genuinely exists — this example file intentionally uses a
# placeholder. This MUST be a different bucket than staging.backend.hcl's
# (Founder Decision C1: SEPARATE BUCKETS) — never the same value in both
# files.

bucket = "REPLACE_WITH_PRODUCTION_STATE_BUCKET_NAME"
prefix = "decivexa-ai-gateway"
